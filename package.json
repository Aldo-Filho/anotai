{
  "name": "anotai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "mobile"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "build": "npm run build --workspace mobile && npm run build --workspace backend",
    "start": "npm start --workspace backend",
    "dev": "concurrently -k \"npm run dev --workspace backend\" \"npm run dev --workspace mobile\"",
    "test": "npm test --workspace backend && node --test scripts/setup.test.mjs",
    "test:e2e": "npm run test:e2e --workspace backend",
    "test:web": "playwright test",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "prettier": "3.9.10"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "deepmerge-ts": "8.0.2",
    "effect": "3.20.0",
    "postcss-selector-parser": "7.1.6",
    "uuid": "11.1.1"
  }
}
